{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "ModuleCatalog": "Information",
        "GroceryStore": "Information",
        "SystemSettings": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}|[{Level:u3}]|{Scope}|{SourceContext:l}|{Message:lj}|{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_WITH_AT_LEAST_32_CHARACTERS_LONG!",
    "Issuer": "API-WebServer",
    "Audience": "API-WebServer-Clients",
    "ExpirationMinutes": 60
  },
  "ConnectionStrings": {
    "GroceryStore": "Data Source=Database/grocery-store.db",
    "Server": "Data Source=Database/server.db"
  },
  "HealthDiagnostics": {
    "BaseAddress": "http://localhost:8080"
  },
  "AllowedHosts": "*"
}
